# ============================================================
# HackMate — environment template
# Copy to .env.local (dev) or set in Vercel project settings.
# Everything below has a FREE tier. Total cost: $0/month.
# ============================================================

# ---------- Database (REQUIRED) ----------
# CockroachDB Serverless (free: 10GB storage, 50M RU/month, no credit card)
# Console: https://cockroachlabs.cloud → Create cluster → SQL user → get connection string
# Use the "General connection string" and set sslmode=verify-full (already handled by the app).
DATABASE_URL=postgresql://<user>:<password>@<cluster>.cockroachlabs.cloud:26257/<database>?sslmode=verify-full
# Local Postgres instead (dev): use 127.0.0.1, NOT localhost — some drivers
# turn "localhost" into a Unix-socket connection and then authenticate as
# your OS username instead of the user in the URL.
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/hackmate
# Optional strict TLS: path to the downloaded CockroachDB root certificate.
# Without this the app uses encrypted-but-unpinned TLS (recommended default).
# DATABASE_SSL_ROOT_CERT=./certs/ccrl.crt

# ---------- Auth.js v5 (REQUIRED) ----------
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=
# Your deployed URL (Vercel: https://your-app.vercel.app)
AUTH_URL=http://localhost:3000

# GitHub OAuth (developers sign-in + repo/language import)
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend — email magic links + notifications (free: 3,000/month)
# https://resend.com → API Keys. Without a custom domain use onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM="HackMate <onboarding@resend.dev>"

# ---------- Pusher — realtime team chat (free: 100 connections, 200k msgs/day) ----------
# https://pusher.com → Channels app → App Keys
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=ap2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ---------- Vercel Blob — avatars & hackathon logos (free: ~250MB) ----------
# Vercel dashboard → Storage → Blob → Create → copy token into env
BLOB_READ_WRITE_TOKEN=

# ---------- Vercel Cron (2 jobs/day on Hobby plan) ----------
# Vercel dashboard → Settings → Environment Variables → CRON_SECRET
# Vercel automatically sends  Authorization: Bearer <CRON_SECRET>  to /api/cron
CRON_SECRET=

# ---------- Admin access (REQUIRED to post hackathons) ----------
# Comma-separated allow-list. Accounts that sign in with these emails are
# automatically promoted to role='admin' and can post/edit/delete hackathons
# at /hackathons/new and /admin. Everyone else is a normal student user.
# Works with GitHub OAuth (matching account email) and magic-link sign-ins.
ADMIN_EMAILS=you@college.edu

# Manual fallback (SQL, e.g. promoting another organizer later):
#   UPDATE "user" SET role = 'admin' WHERE email = 'friend@college.edu';
# Demote:  UPDATE "user" SET role = 'user' WHERE email = '...';

# ---------- Optional / dev-only ----------
# DEV ONLY: enables the "Quick dev sign-in — admin" button, which signs in as
# your first ADMIN_EMAILS account (or dev@hackmate.local) with admin rights.
# Never enable in production.
# ALLOW_DEMO_LOGIN=true
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN=true
